---
import '../styles/global.css';
import settings from '../content/settings.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = settings.seo.title, description = settings.seo.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = settings.seo.ogImage ? new URL(url(settings.seo.ogImage), Astro.site).href : '';
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Картинка й опис, коли посилання на сайт надсилають у месенджер чи соцмережу -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${url('favicon.svg')}?v=2`} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Шрифт з макета: Inter Tight (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Курсор як на revelatio.studio: біла точка з інверсією (interactive.js) -->
    <div class="cursor" aria-hidden="true" data-cursor></div>
    <script>
      import '../scripts/animations.js';
      import '../scripts/interactive.js';
    </script>
  </body>
</html>
