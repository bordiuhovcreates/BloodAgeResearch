---
import Base from '../layouts/Base.astro';
import Block1 from '../components/Block1.astro';
import Block2 from '../components/Block2.astro';
import Block3 from '../components/Block3.astro';
import Block4 from '../components/Block4.astro';
import Block5 from '../components/Block5.astro';
import Block6 from '../components/Block6.astro';
import Block7 from '../components/Block7.astro';
import Block8 from '../components/Block8.astro';
import Block9 from '../components/Block9.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup.astro';
import Menu from '../components/Menu.astro';
import home from '../content/home.json';
import { url } from '../lib/url';
---
<Base>
  {/* Постер відео першого екрана — найбільший елемент екрана: вантажимо його першим */}
  {home.hero.poster && <link slot="head" rel="preload" as="image" href={url(home.hero.poster)} fetchpriority="high" />}
  <main>
    <Block1 />
    <Block2 />
    <Block3 />
    <Block4 />
    <Block5 />
    <Block6 />
    <Block7 />
    <Block8 />
    <Block9 />
  </main>
  <Footer />
  <Popup />
  <Menu />
</Base>
