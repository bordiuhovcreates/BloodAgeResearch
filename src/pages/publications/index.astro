---
// Сторінка публікацій (як новини на Syntrex, але в стилі сайту): шапка за сіткою як перший екран — червоний
// підпис, заголовок 96 у два рядки; далі вкладки тем і сітка 4 × 445.
// Статті — Markdown у src/content/publications/, тексти сторінки — src/content/blog.json.
// Розміри — px макета 1920 × --u.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Popup from '../../components/Popup.astro';
import Menu from '../../components/Menu.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import blog from '../../content/blog.json';
import legal from '../../content/legal.json';
import { url } from '../../lib/url';
import { getPublications, readTime, publicationHref } from '../../lib/publications';

const posts = await getPublications();
const categories = [...new Set(posts.map((p) => p.data.category))];
---
<Base title={blog.seoTitle} description={blog.seoDescription}>
  <main class="pubs">
    <a class="pubs__home" href={url('/')}><span data-decrypt>{legal.home}</span></a>


    <div class="pubs__head" data-anim="fade-up">
      <p class="pubs__label">{blog.label}</p>
      <h1 class="pubs__title t-h1">{blog.title}</h1>
    </div>

    <div class="pubs__tabs" role="toolbar" aria-label={blog.category} data-anim="fade-up">
      <button type="button" class="pubs__tab is-active" data-filter="all" aria-pressed="true">{blog.all}<sup>{posts.length}</sup></button>
      {categories.map((c) => (
        <button type="button" class="pubs__tab" data-filter={c} aria-pressed="false">{c}<sup>{posts.filter((p) => p.data.category === c).length}</sup></button>
      ))}
    </div>

    <ul class="pubs__grid" role="list">
      {posts.map((post) => (
        <li class="pubs__item" data-cat={post.data.category}>
          <PublicationCard
            href={publicationHref(post)}
            title={post.data.title}
            text={post.data.description}
            readTime={`${readTime(post)} ${blog.minRead}`}
            image={post.data.image}
          />
        </li>
      ))}
    </ul>
    <p class="pubs__empty" hidden data-empty>{blog.empty}</p>
  </main>
  <Footer />
  <Popup />
  <Menu />
</Base>

<style>
  /* Назва сайту — як на першому екрані (на 50 від верху, 40 від краю); заголовок на 160 від верху */
  .pubs { position: relative; padding: calc(160 * var(--u)) var(--gutter) 0; }
  .pubs__home { position: absolute; top: calc(50 * var(--u)); left: var(--gutter); color: var(--color-accent); }

  /* Шапка за сіткою 4 × 445, як перший екран: червоний підпис згори, заголовок 96 у два рядки (переноси з тексту)
     на колонки 1–3 */
  .pubs__head {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: var(--gap-20);
    row-gap: var(--gap-40);
    align-items: end;
  }
  .pubs__label { grid-column: 1 / -1; color: var(--color-accent); }
  .pubs__title { grid-column: 1 / 4; white-space: pre-line; }

  /* Вкладки тем: пунктир і скруглення як у квадрата картки, кількість статей маленьким сірим числом;
     обрана — червона */
  .pubs__tabs { display: flex; flex-wrap: wrap; gap: var(--gap-10); margin-top: var(--gap-100); }
  .pubs__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-6);
    height: var(--chip-height);
    padding: 0 var(--gap-20);
    border: 1px var(--line-style) var(--color-silver-gray);
    border-radius: var(--radius-s);
    line-height: 1;
    transition: background-color 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .pubs__tab sup { align-self: flex-start; margin-top: var(--gap-12); font-size: var(--caption-size); line-height: 1; color: var(--color-text-muted); }
  .pubs__tab.is-active { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-white); }
  .pubs__tab.is-active sup { color: var(--color-white); }
  .pubs__tab:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  @media (hover: hover) {
    .pubs__tab:not(.is-active):hover { border-color: var(--color-text); }
  }

  /* Рівна сітка 4 × 445 з проміжком 20, як у Блоці 9 */
  .pubs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-20);
    margin-top: var(--gap-40);
  }
  .pubs__item[hidden] { display: none; }
  .pubs__item.is-in { animation: pubs-in 0.5s var(--ease-out) both; }
  .pubs__empty { margin-top: var(--gap-40); color: var(--color-text-muted); }
  @keyframes pubs-in {
    from { opacity: 0; translate: 0 var(--gap-20); }
    to { opacity: 1; translate: 0 0; }
  }

  /* Мобільна і планшет — за мобільним макетом головної: назва сайту на 31 від верху (по центру кнопки меню 35),
     підпис на 95 (там, де заголовок першого екрана), заголовок 40 на 20 нижче; вкладки 35 (як квадрати
     в картках) на 40 нижче; картки 350 × 430 (як у Блоці 9) у колонку через 20 */
  @media (max-width: 1023px) {
    .pubs { padding-top: calc(95 * var(--u)); }
    .pubs__home { top: calc(31 * var(--u)); }
    .pubs__head { grid-template-columns: 1fr; row-gap: var(--gap-20); }
    .pubs__title { grid-column: auto; overflow-wrap: break-word; }
    .pubs__tabs { margin-top: var(--gap-40); }
    .pubs__tab { height: calc(35 * var(--u)); padding: 0 var(--gap-15); }
    .pubs__tab sup { margin-top: var(--gap-6); }
    .pubs__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Фільтр за темами
  const opts = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.pubs__item')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  opts.forEach((opt) => opt.addEventListener('click', () => {
    const f = opt.dataset.filter;
    opts.forEach((o) => { const on = o === opt; o.classList.toggle('is-active', on); o.setAttribute('aria-pressed', String(on)); });
    let shown = 0;
    items.forEach((el) => {
      const ok = f === 'all' || el.dataset.cat === f;
      el.hidden = !ok;
      el.classList.remove('is-in');
      if (ok) { void el.offsetWidth; el.classList.add('is-in'); shown++; }
    });
    if (empty) empty.hidden = shown > 0;
  }));
</script>
