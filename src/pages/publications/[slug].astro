---
// Сторінка статті (як на Syntrex, але в стилі сайту): шапка за сіткою 4 × 445 — тема │ заголовок (колонки 2–3) │
// дата і час читання; пунктир на всю ширину; далі обкладинка (фото з картки), вступ і текст у колонках 2–3.
// Згори — смуга прогресу читання.
// Текст — Markdown у src/content/publications/. Розміри — px макета 1920 × --u.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Popup from '../../components/Popup.astro';
import Menu from '../../components/Menu.astro';
import blog from '../../content/blog.json';
import legal from '../../content/legal.json';
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import { url } from '../../lib/url';
import { getPublications, readTime, formatDate, type Publication } from '../../lib/publications';

export async function getStaticPaths() {
  const posts = await getPublications();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Publication }
const { post } = Astro.props;
const { title, description, category, date, image } = post.data;
const { Content } = await render(post);
// Обкладинка 910×500: для pub-1-405.webp беремо pub-1-910.webp і, якщо є, pub-1-1820.webp (чіткі екрани).
// Якщо окремої версії 910 немає — показуємо фото з картки.
const coverSize = (w: number) => image.replace(/-405\.webp$/, `-${w}.webp`);
const hasFile = (p: string) => /-405\.webp$/.test(image) && existsSync(`public/${p.replace(/^\//, '')}`);
const cover = hasFile(coverSize(910)) ? coverSize(910) : image;
const coverSrcset = hasFile(coverSize(1820))
  ? `${url(coverSize(910))} 910w, ${url(coverSize(1820))} 1820w`
  : undefined;
---
<Base title={`${title} — ${legal.home}`} description={description}>
  <div class="art-progress" aria-hidden="true"><span data-progress></span></div>
  <main class="art">
    <a class="art__home" href={url('/')}><span data-decrypt>{legal.home}</span></a>


    <header class="art__head">
      <a class="art__cat" href={url('publications/')} data-anim="fade-up">{category}</a>
      <h1 class="art__title t-h2" data-anim="fade-up">{title}</h1>
      <div class="art__chips" data-anim="fade-up">
        <span class="art__chip">{formatDate(date)}</span>
        <span class="art__chip">{readTime(post)} {blog.minRead}</span>
      </div>
    </header>

    <div class="art__body">
      {/* Обкладинка — те саме фото, що в картці статті (один раз, над вступом) */}
      <figure class="art__cover" data-anim="fade-up">
        <img src={url(cover)} srcset={coverSrcset} sizes="(min-width: 1024px) 48vw, 100vw" alt="" width="910" height="500" fetchpriority="high" />
      </figure>
      <p class="art__lead" data-anim="fade-up">{description}</p>
      <article class="art__prose" data-article>
        <Content />
      </article>
    </div>
  </main>
  <Footer />
  <Popup />
  <Menu />
</Base>

<style>
  /* Назва сайту — як на першому екрані (на 50 від верху, 40 від краю); шапка статті на 160 від верху */
  .art { position: relative; padding: calc(160 * var(--u)) var(--gutter) 0; }
  .art__home { position: absolute; top: calc(50 * var(--u)); left: var(--gutter); color: var(--color-accent); }

  /* Смуга прогресу читання: червона, згори на всю ширину */
  .art-progress { position: fixed; inset: 0 0 auto 0; z-index: 980; height: var(--progress-height); pointer-events: none; }
  .art-progress span { display: block; height: 100%; background: var(--color-accent); transform: scaleX(0); transform-origin: left; }

  /* Шапка за сіткою 4 × 445: тема │ заголовок (2–3) │ дата і час читання. Знизу пунктир на всю ширину */
  .art__head {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-20);
    align-items: start;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--gap-100);
    border-bottom: 1px var(--line-style) var(--color-silver-gray);
  }
  .art__cat { justify-self: start; color: var(--color-accent); }
  /* Рівні рядки в статті: заголовки, вступ, цитати й підписи — balance; абзаци — pretty (без одного слова в кінці) */
  .art__title { grid-column: 2 / 4; text-wrap: balance; }
  .art__lead,
  .art__prose :global(h2),
  .art__prose :global(blockquote),
  .art__prose :global(figcaption) { text-wrap: balance; }
  .art__prose :global(p),
  .art__prose :global(li) { text-wrap: pretty; }
  .art__chips { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--gap-10); }
  .art__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-10);
    height: var(--chip-height);
    padding: 0 var(--gap-20);
    border: 1px var(--line-style) var(--color-silver-gray);
    border-radius: var(--radius-s);
    line-height: 1;
    white-space: nowrap;
  }
  .art__chip::before { content: ''; width: var(--dot-size); height: var(--dot-size); border-radius: 50%; background: var(--color-accent); }

  /* Вступ і текст — у колонках 2–3, рівно під заголовком */
  .art__body { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap-20); margin-top: var(--gap-100); }
  .art__cover, .art__lead, .art__prose { grid-column: 2 / 4; }
  /* Обкладинка: пропорції як у фото в тексті (910×500), скруглення як у картках; вступ на 60 нижче */
  .art__cover { margin-bottom: var(--gap-60); border-radius: var(--radius-m); overflow: hidden; background: var(--color-soft); }
  .art__cover img { display: block; width: 100%; height: auto; aspect-ratio: 910 / 500; object-fit: cover; }
  .art__lead { font-size: var(--h3-size); line-height: var(--lead-lh); color: var(--color-text-muted); }

  /* Типографіка статті: як у юридичних сторінках — розділи через 60, абзаци через 20 */
  .art__prose { margin-top: var(--gap-60); line-height: var(--article-lh); }
  .art__prose > :global(* + *) { margin-top: var(--gap-20); }
  .art__prose :global(h2) { margin-top: var(--gap-60); font-size: var(--h3-size); line-height: var(--h3-lh); }
  .art__prose :global(h2 + *) { margin-top: var(--gap-20); }
  .art__prose :global(strong) { font-weight: var(--weight-bold); }
  .art__prose :global(em) { color: var(--color-text-muted); font-style: normal; }
  .art__prose :global(a) { text-decoration: underline; text-underline-offset: 0.2em; transition: color 0.3s var(--ease-soft); }
  .art__prose :global(a:hover) { color: var(--color-accent); }
  .art__prose :global(ul), .art__prose :global(ol) { padding-left: var(--gap-20); }
  .art__prose :global(li + li) { margin-top: var(--gap-10); }
  .art__prose :global(li::marker) { color: var(--color-accent); }

  /* Фото на всю ширину колонок 2–3, скруглення як у картках, підпис сірим */
  .art__prose :global(figure) { margin-block: var(--gap-60); }
  .art__prose :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 910 / 500;
    object-fit: cover;
    border-radius: var(--radius-m);
    background: var(--color-soft);
  }
  .art__prose :global(figcaption) { margin-top: var(--gap-20); font-size: var(--caption-size); line-height: var(--article-lh); color: var(--color-text-muted); }

  /* Цитата: пунктир зверху і знизу, як скрізь на сайті */
  .art__prose :global(blockquote) {
    margin-block: var(--gap-60);
    padding-block: var(--gap-40);
    border-block: 1px var(--line-style) var(--color-silver-gray);
    font-size: var(--h3-size);
    line-height: var(--lead-lh);
  }

  /* Мобільна: усе в одну колонку, дата і час під заголовком */
  /* Мобільна і планшет — за мобільним макетом головної: назва сайту на 31 (по центру кнопки меню 35),
     шапка статті на 95; тема, заголовок 36 і плашки 35 (як квадрати в картках) через 20 */
  @media (max-width: 1023px) {
    .art { padding-top: calc(95 * var(--u)); }
    .art__home { top: calc(31 * var(--u)); }
    .art__head { row-gap: var(--gap-20); }
    .art__chip { height: calc(35 * var(--u)); padding: 0 var(--gap-15); }
    .art__cover { border-radius: var(--radius-s); }
    .art__head, .art__body { grid-template-columns: 1fr; }
    .art__title, .art__cover, .art__lead, .art__prose { grid-column: auto; min-width: 0; overflow-wrap: break-word; }
    .art__cover { margin-bottom: var(--gap-40); }
    .art__head { padding-bottom: var(--gap-40); }
    .art__chips { justify-content: flex-start; }
    .art__body { margin-top: var(--gap-40); }
    .art__prose { margin-top: var(--gap-40); }
    .art__prose :global(h2) { margin-top: var(--gap-40); }
    .art__prose :global(figure), .art__prose :global(blockquote) { margin-block: var(--gap-40); }
    .art__prose :global(blockquote) { padding-block: var(--gap-20); }
  }
</style>

<script>
  // Прогрес читання: смуга вгорі заповнюється від початку до кінця тексту статті
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  const progress = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.5;
    const done = Math.min(1, Math.max(0, (window.innerHeight * 0.5 - r.top) / total));
    bar.style.transform = `scaleX(${done})`;
  };
  window.addEventListener('scroll', progress, { passive: true });
  window.addEventListener('resize', progress);
  progress();
</script>
