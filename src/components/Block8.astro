---
// Блок 8 — питання та відповіді (Figma: 383:414). Ліворуч заголовок прилипає, поки прокручується список
// (зупиняється на 40 вище нижнього тексту); праворуч — червона кількість питань і акордеон:
// відкрита одна відповідь, плюс повертається в хрестик на червоному квадраті; при появі лінії
// проростають зліва, а питання по черзі піднімаються (data-accordion в animations.js).
// Розміри — px макета 1920 × --u.
import home from '../content/home.json';
import { url } from '../lib/url';
const { faq } = home;
const plus = `--icon: url(${url('icons/plus.svg')})`;
---
<section class="block8" id="block-8" data-accordion>
  <div class="block8__side">
    <div class="block8__pin">
      <div class="block8__head">
        <p>{faq.label}</p>
        <h2 class="block8__title t-h2">
          {faq.titleStart}<br /><span class="block8__accent">{faq.titleAccent}</span><br />{faq.titleEnd}
        </h2>
      </div>
    </div>
    <p class="block8__text">{faq.text}</p>
  </div>

  <div class="block8__main">
    <span class="block8__count t-h2" data-acc-reveal>{faq.items.length}</span>
    <div class="block8__list" data-acc-reveal>
      {faq.items.map((item, i) => (
        <div class="block8__item" data-acc-item>
          <button
            class="block8__q"
            type="button"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            data-acc-trigger
            data-acc-reveal
          >
            <span>{item.question}</span>
            <span class="block8__icon" aria-hidden="true"><span class="block8__plus" style={plus}></span></span>
          </button>
          <div class="block8__body" id={`faq-answer-${i}`}>
            <div class="block8__wrap"><p class="block8__a">{item.answer}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* 250 від Блоку 7; ліва колонка до x 970 (50% + 10), права — до поля */
  .block8 {
    margin-top: var(--section-gap);
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: calc(50% + 10 * var(--u)) 1fr;
  }

  /* Ліворуч: заголовок прилипає; його доріжка закінчується на 40 вище нижнього тексту */
  .block8__side { display: flex; flex-direction: column; }
  .block8__pin { flex: 1; padding-bottom: var(--gap-40); }
  .block8__head { position: sticky; top: var(--gap-40); padding-top: var(--gap-10); }
  .block8__title { margin-top: calc(30 * var(--u)); }
  .block8__accent { color: var(--color-accent); }
  .block8__text { margin-top: auto; width: calc(352 * var(--u)); line-height: 1.01; }

  .block8__count { display: block; color: var(--color-accent); }

  /* Лінії — ::before / ::after, щоб проростати зліва при появі. Закрите питання — 108:
     30 над рядком 48, 20 + 10 під ним (як у Figma) */
  .block8__list { position: relative; margin-top: calc(30 * var(--u)); }
  .block8__list::before,
  .block8__item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px var(--line-style) var(--color-silver-gray);
    transform-origin: left;
    transition: transform 0.9s var(--ease-out) var(--d, 0s);
  }
  .block8__list::before { top: 0; }
  .block8__item { position: relative; padding-bottom: var(--gap-10); }
  .block8__item::after { bottom: -1px; }

  .block8__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: calc(30 * var(--u)) 0 var(--gap-20);
    font-size: var(--h3-size);
    line-height: var(--h3-lh);
    text-align: left;
    white-space: nowrap;
  }
  /* Квадрат 48: лінія, червоний лише коли відкрито; плюс повертається на 45° у хрестик */
  .block8__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(48 * var(--u));
    height: calc(48 * var(--u));
    border: 1px var(--line-style) var(--color-silver-gray);
    border-radius: var(--radius-s);
    transition: background-color 0.5s var(--ease-soft), border-color 0.5s var(--ease-soft);
  }
  .block8__plus {
    width: calc(24 * var(--u));
    height: calc(24 * var(--u));
    background: var(--color-text);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
    transition: transform 0.6s var(--ease-out), background-color 0.5s var(--ease-soft);
  }
  .block8__item.is-open .block8__icon { background: var(--color-accent); border-color: var(--color-accent); }
  .block8__item.is-open .block8__plus { background: var(--color-white); transform: rotate(45deg); }

  /* Відповідь розкривається плавно; та, що закривається, — у тому ж темпі */
  .block8__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease-soft); }
  .block8__wrap { min-height: 0; overflow: hidden; }
  .block8__a {
    width: calc(414 * var(--u));
    padding-bottom: var(--gap-20);
    line-height: 1.01;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(var(--gap-10));
    transition: opacity 0.5s var(--ease-soft), transform 0.6s var(--ease-out);
  }
  .block8__item.is-open .block8__body { grid-template-rows: 1fr; }
  .block8__item.is-open .block8__a { opacity: 1; transform: none; }

  /* Поява (animations.js: is-pending → прибирається, коли список на екрані):
     лінії проростають зліва, кількість і питання по черзі піднімаються */
  .block8__count,
  .block8__q { transition: opacity 0.8s var(--ease-soft) var(--d, 0s), transform 0.9s var(--ease-out) var(--d, 0s); }
  .block8.is-pending .block8__list::before,
  .block8.is-pending .block8__item::after { transform: scaleX(0); }
  .block8.is-pending .block8__count,
  .block8.is-pending .block8__q { opacity: 0; transform: translateY(var(--gap-20)); }

  /* Мобільна і планшет (Figma: mobile 409:3482, 8 section; макет 390). Одна колонка без прилипання:
     підпис, заголовок 36 у 3 рядки; на 50 нижче — список (кількості питань немає); питання 20 з полями 20
     зверху і знизу, квадрат 35 з плюсом 17.5 по центру висоти; відкрита відповідь чорна, ширина 279, на 20 нижче
     питання і 20 над лінією; під списком на 20 — текст 18 (ширина 352) */
  @media (max-width: 1023px) {
    .block8 { display: flex; flex-direction: column; }
    .block8__side { display: contents; }
    .block8__pin { order: 0; padding-bottom: 0; }
    .block8__head { position: static; padding-top: 0; }
    .block8__title { margin-top: var(--gap-20); }
    .block8__main { order: 1; margin-top: calc(50 * var(--u)); }
    .block8__count { display: none; }
    .block8__list { margin-top: 0; }
    .block8__item { padding-bottom: 0; }
    /* Переноси питань — точно як у Figma (\n у тексті); на десктопі \n не діє (nowrap) */
    .block8__q {
      gap: var(--gap-20);
      padding: var(--gap-20) 0;
      white-space: pre-line;
    }
    .block8__icon { width: calc(35 * var(--u)); height: calc(35 * var(--u)); }
    .block8__plus { width: calc(17.5 * var(--u)); height: calc(17.5 * var(--u)); }
    .block8__a { width: auto; max-width: calc(279 * var(--u)); line-height: 1; color: var(--color-text); }
    .block8__text {
      order: 2;
      width: calc(352 * var(--u));
      margin-top: var(--gap-20);
      font-size: var(--text-18-size);
    }
  }
</style>
